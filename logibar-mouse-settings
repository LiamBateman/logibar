#!/usr/bin/env python3
"""Per-mouse Hyprland Lua settings for Logibar; changes require explicit apply."""
import argparse
import fcntl
import json
import math
import os
from pathlib import Path
import re
import subprocess
import sys
import tempfile

CONFIG = Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config")
PROFILE = {"", "flat", "adaptive"}
MARKER = "-- Logibar mouse settings (managed include)"
MOUSE = re.compile(r"^logitech-(?:g-pro|pro-x-superlight)(?:-|$)")


def run(*args):
    result = subprocess.run(args, capture_output=True, text=True, timeout=8)
    if result.returncode:
        raise ValueError(result.stderr.strip() or result.stdout.strip() or "Command failed")
    return result.stdout.strip()


def validate(name, speed, profile):
    if not isinstance(name, str) or not MOUSE.match(name) or not re.fullmatch(r"[a-z0-9-]+", name):
        raise ValueError("Select a supported Logitech mouse")
    if isinstance(speed, bool) or not isinstance(speed, (float, int)) or not math.isfinite(speed) or not -1 <= speed <= 1:
        raise ValueError("Sensitivity must be between -1 and 1")
    if profile not in PROFILE:
        raise ValueError("Choose Default, Off, or Adaptive acceleration")


def paths():
    return CONFIG / "logibar/mouse-settings.json", CONFIG / "hypr/logibar-mouse.lua", CONFIG / "hypr/hyprland.lua"


def read_settings():
    path = paths()[0]
    if not path.exists():
        return {}
    if path.stat().st_size > 65536:
        raise ValueError("Mouse settings file is too large")
    data = json.loads(path.read_text())
    if not isinstance(data, dict):
        raise ValueError("Invalid mouse settings")
    for name, value in data.items():
        validate(name, value["sensitivity"], value["accel_profile"])
    return data


def connected():
    data = json.loads(run("hyprctl", "devices", "-j"))
    return sorted({d["name"] for d in data["mice"] if MOUSE.match(d["name"])})


def status():
    saved = read_settings()
    return {"devices": [{"name": n, "settings": saved.get(n)} for n in connected()]}


def atomic_write(path, text):
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=path.parent, prefix=".logibar-")
    try:
        with os.fdopen(fd, "w") as stream:
            stream.write(text)
        os.replace(tmp, path)
    finally:
        if os.path.exists(tmp):
            os.unlink(tmp)


def render(data):
    lines = ["-- Generated by logibar-mouse-settings. Change settings in the Logibar panel."]
    for name, value in sorted(data.items()):
        validate(name, value["sensitivity"], value["accel_profile"])
        lines.append('hl.device({ name = "%s", sensitivity = %.2f, accel_profile = "%s" })' %
                     (name, value["sensitivity"], value["accel_profile"]))
    return "\n".join(lines) + "\n"


def apply(name, speed, profile):
    validate(name, speed, profile)
    if name not in connected():
        raise ValueError("Mouse disconnected; reconnect it before applying")
    state, generated, main = paths()
    if not main.is_file():
        raise ValueError("Mouse controls require a Hyprland Lua configuration")
    before_errors = run("hyprctl", "configerrors")
    if before_errors:
        raise ValueError("Resolve existing Hyprland configuration errors before applying")
    state.parent.mkdir(parents=True, exist_ok=True)
    with (state.parent / "mouse-settings.lock").open("a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        data = read_settings()
        data[name] = {"sensitivity": round(speed, 2), "accel_profile": profile}
        main_text = main.read_text()
        include = ('\n' + MARKER + '\ndofile((os.getenv("XDG_CONFIG_HOME") or '
                   '(os.getenv("HOME") .. "/.config")) .. "/hypr/logibar-mouse.lua")\n')
        originals = {p: p.read_text() if p.exists() else None for p in (state, generated, main)}
        if MARKER not in main_text:
            backup = main.with_name("hyprland.lua.before-logibar")
            if not backup.exists():
                atomic_write(backup, main_text)
        try:
            atomic_write(generated, render(data))
            if MARKER not in main_text:
                atomic_write(main, main_text.rstrip() + "\n" + include)
            run("hyprctl", "reload")
            errors = run("hyprctl", "configerrors")
            if errors:
                raise ValueError("Hyprland rejected the settings: " + errors)
            atomic_write(state, json.dumps(data, indent=2) + "\n")
        except Exception:
            # Restore the include before removing a newly generated file.
            for path in (main, generated, state):
                old = originals[path]
                if old is None:
                    path.unlink(missing_ok=True)
                elif not path.exists() or path.read_text() != old:
                    atomic_write(path, old)
            run("hyprctl", "reload")
            raise
    result = status()
    result["saved"] = True
    return result


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    sub = parser.add_subparsers(dest="command", required=True)
    sub.add_parser("status")
    save = sub.add_parser("apply")
    save.add_argument("device")
    save.add_argument("sensitivity", type=float)
    save.add_argument("profile", choices=sorted(PROFILE))
    args = parser.parse_args()
    try:
        result = status() if args.command == "status" else apply(args.device, args.sensitivity, args.profile)
        print(json.dumps(result))
    except (ValueError, OSError, KeyError, TypeError, subprocess.SubprocessError) as error:
        print(json.dumps({"error": str(error)}))
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
